
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#09172b">
<title>JARVIS V9</title>

<style>
*{box-sizing:border-box}
:root{--cyan:#65dfff;--panel:rgba(5,20,39,.82)}
body{margin:0;color:#fff;font-family:Arial,sans-serif;background:#09172b}
.scene{min-height:100vh;position:relative;isolation:isolate;overflow:hidden;
background:linear-gradient(#152b51 0%,#d57c83 38%,#f7b58b 52%,#09172b 82%)}
.sun{position:absolute;z-index:-2;width:170px;height:170px;border-radius:50%;
background:#ffbd92;left:50%;top:27%;transform:translateX(-50%);
box-shadow:0 0 100px 35px #ffad8b55}
.mountains{position:absolute;z-index:-1;top:0;left:0;width:100%;height:100%;pointer-events:none}
header{padding:22px;display:flex;justify-content:space-between;align-items:center;gap:12px}
.brand{font-weight:bold;letter-spacing:3px;font-size:22px}
.brand small{display:block;font-size:10px;letter-spacing:1px;font-weight:normal;margin-top:5px}
.datetime{text-align:right;font-size:20px}
.datetime small{display:block;font-size:11px;margin-top:5px}
main{max-width:850px;padding:20px 16px 35px;margin:auto}
.intro{text-align:center;margin:15px 0 26px}
h1{font-size:clamp(26px,5vw,38px);margin:0 0 10px}
.intro p{font-size:14px}
.command{max-width:540px;margin:25px auto 30px;display:flex;gap:8px;
align-items:center;padding:7px 9px 7px 18px;border:1px solid var(--cyan);
border-radius:40px;background:var(--panel)}
.command input{flex:1;min-width:0;border:0;outline:0;background:transparent;
color:white;font-size:16px;padding:10px 0}
.command input::placeholder{color:#cbd9ed}
button{font:inherit;color:white;cursor:pointer}
.round{border:0;border-radius:50%;background:#138bdb;width:42px;height:42px;flex-shrink:0}
.grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:11px}
.card{min-height:100px;border:1px solid #ffffff30;border-radius:15px;
background:var(--panel);display:flex;flex-direction:column;align-items:center;
justify-content:center;gap:12px;transition:.2s}
.card:hover{border-color:var(--cyan);background:#174b6a}
.icon{font-size:27px;color:#c9edff}
.card span:last-child{font-size:12px}
.panel{margin-top:20px;border:1px solid #ffffff30;border-radius:15px;
background:var(--panel);padding:16px}
.panel-title{font-size:10px;letter-spacing:2px;color:var(--cyan);margin-bottom:10px}
#reply{font-size:14px;line-height:1.6;overflow-wrap:anywhere}
#reply:before{content:"> ";color:var(--cyan)}
.hidden{display:none!important}
.weather-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:14px}
.stat{padding:13px;border:1px solid #ffffff20;border-radius:12px;background:#ffffff0b}
.stat small{display:block;color:#d4e4f6;margin-bottom:8px}
.stat strong{font-size:22px}
.action{margin-top:12px;padding:10px 14px;border:1px solid var(--cyan);
border-radius:10px;background:#0b3654}
.spotify{display:block;width:100%;height:352px;border:0;border-radius:12px;margin-top:12px}
a{color:var(--cyan)}
footer{text-align:center;padding:25px 5px;color:#d3e4f2;font-size:10px;letter-spacing:2px}
@media(max-width:540px){
 header{padding:17px 14px}.brand{font-size:18px}.datetime{font-size:16px}
 main{padding:12px 12px 28px}.grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}
 .card{min-height:88px}.icon{font-size:24px}
}
</style>
</head>

<body>
<div class="scene">
<div class="sun"></div>

<svg class="mountains" viewBox="0 0 1200 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
<path fill="#425472" d="M0 440L110 350 175 390 300 245 390 350 500 190 610 350 735 225 850 360 965 270 1080 360 1200 285V900H0Z"/>
<path fill="#263a59" d="M0 530L130 420 245 490 360 390 490 520 625 395 755 510 890 410 1020 505 1120 430 1200 480V900H0Z"/>
<path fill="#101c30" d="M0 650L150 500 260 570 410 460 560 600 720 485 860 585 1010 480 1200 590V900H0Z"/>
<path fill="#07101d" d="M0 770L220 660 430 745 620 650 800 765 1010 665 1200 755V900H0Z"/>
</svg>

<header>
<div class="brand">JARVIS<small>YOUR PERSONAL ASSISTANT</small></div>
<div class="datetime"><span id="clock">--:--</span><small id="date">Loading...</small></div>
</header>

<main>
<div class="intro">
<h1 id="greeting">Welcome back.</h1>
<p>Your assistant is ready. What would you like to do?</p>
</div>

<form class="command" id="commandForm">
<input id="commandInput" placeholder="Type or speak a command..." autocomplete="off">
<button class="round" id="micButton" type="button" aria-label="Voice input">🎙</button>
<button class="round" type="submit" aria-label="Send">➤</button>
</form>

<div class="grid">
<button class="card" data-command="help"><span class="icon">▤</span><span>Commands</span></button>
<button class="card" data-command="notes"><span class="icon">▧</span><span>Notes</span></button>
<button class="card" data-command="calculator"><span class="icon">▦</span><span>Calculator</span></button>
<button class="card" data-command="weather"><span class="icon">☁</span><span>Weather</span></button>
<button class="card" data-command="music"><span class="icon">♫</span><span>Music</span></button>
</div>

<section class="panel">
<div class="panel-title">JARVIS RESPONSE</div>
<div id="reply" aria-live="polite">JARVIS is ready. Type or speak a command.</div>
</section>

<section class="panel hidden" id="weatherPanel">
<h2>🌦️ Live Weather · Delhi</h2>
<div id="weatherStatus" aria-live="polite">Weather not loaded yet.</div>
<div class="weather-grid">
<div class="stat"><small>Temperature</small><strong id="temperature">--</strong></div>
<div class="stat"><small>Feels like</small><strong id="feelsLike">--</strong></div>
<div class="stat"><small>Humidity</small><strong id="humidity">--</strong></div>
<div class="stat"><small>Wind speed</small><strong id="windSpeed">--</strong></div>
</div>
<button class="action" type="button" id="refreshWeather">↻ Refresh weather</button>
</section>

<section class="panel hidden" id="musicPanel">
<h2>🎵 Your Spotify Playlist</h2>
<p>Choose a track in the player below. Playback may require Spotify sign-in.</p>
<iframe class="spotify" id="spotifyPlayer"
title="Spotify playlist player"
src="https://open.spotify.com/embed/playlist/1Zxvk6LxitGP1gUmeu40KK?utm_source=generator"
allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
loading="lazy"></iframe>
<p>If the player does not load, <a href="https://open.spotify.com/playlist/1Zxvk6LxitGP1gUmeu40KK" target="_blank" rel="noopener noreferrer">open your playlist in Spotify ↗</a>.</p>
</section>

<footer>JARVIS V9 · DREAM · PLAN · ACHIEVE</footer>
</main>
</div>

<script>
"use strict";

const $ = id => document.getElementById(id);
const input = $("commandInput");
const reply = $("reply");
let recognition = null;
let weatherLoading = false;

function speak(message) {
  if (!("speechSynthesis" in window)) return;
  window.speechSynthesis.cancel();
  const speech = new SpeechSynthesisUtterance(message);
  speech.lang = "en-IN";
  speech.rate = 1;
  window.speechSynthesis.speak(speech);
}

function respond(message, speakMessage = true) {
  reply.textContent = message;
  if (speakMessage) speak(message);
}

function updateClock() {
  const now = new Date();
  $("clock").textContent = now.toLocaleTimeString([], {
    hour: "2-digit", minute: "2-digit"
  });
  $("date").textContent = now.toLocaleDateString([], {
    weekday: "short", day: "numeric", month: "short", year: "numeric"
  });

  const hour = now.getHours();
  $("greeting").textContent =
    (hour < 12 ? "Good Morning" : hour < 17 ? "Good Afternoon" : "Good Evening") +
    ", Riyansh";
}
updateClock();
setInterval(updateClock, 1000);

function weatherDescription(code) {
  if (code === 0) return "Clear sky";
  if ([1, 2].includes(code)) return "Mostly clear / partly cloudy";
  if (code === 3) return "Overcast";
  if ([45, 48].includes(code)) return "Foggy";
  if ([51, 53, 55, 56, 57].includes(code)) return "Drizzle";
  if ([61, 63, 65, 66, 67, 80, 81, 82].includes(code)) return "Rain";
  if ([71, 73, 75, 77, 85, 86].includes(code)) return "Snow";
  if ([95, 96, 99].includes(code)) return "Thunderstorm";
  return "Current conditions";
}

async function loadWeather() {
  if (weatherLoading) return;
  weatherLoading = true;
  $("weatherPanel").classList.remove("hidden");
  $("weatherStatus").textContent = "Fetching live weather...";
  $("refreshWeather").disabled = true;

  try {
    // Delhi coordinates. No GPS permission is needed.
    const url = "https://api.open-meteo.com/v1/forecast" +
      "?latitude=28.6139&longitude=77.2090" +
      "&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m" +
      "&timezone=Asia%2FKolkata";

    const response = await fetch(url);
    if (!response.ok) throw new Error("Weather service unavailable");

    const data = await response.json();
    const current = data.current;
    if (!current) throw new Error("No current weather data");

    $("temperature").textContent = Math.round(current.temperature_2m) + "°C";
    $("feelsLike").textContent = Math.round(current.apparent_temperature) + "°C";
    $("humidity").textContent = Math.round(current.relative_humidity_2m) + "%";
    $("windSpeed").textContent = Math.round(current.wind_speed_10m) + " km/h";

    const updated = new Date(current.time).toLocaleTimeString([], {
      hour: "2-digit", minute: "2-digit"
    });
    $("weatherStatus").textContent =
      weatherDescription(current.weather_code) + " · Updated " + updated;
    respond("Here is the latest weather for Delhi.", false);
  } catch (error) {
    $("weatherStatus").textContent =
      "Weather could not load. Check your internet and tap Refresh weather.";
    respond("I could not load the weather. Please check your internet connection.", false);
  } finally {
    weatherLoading = false;
    $("refreshWeather").disabled = false;
  }
}

function showMusic() {
  $("musicPanel").classList.remove("hidden");
  $("musicPanel").scrollIntoView({ behavior: "smooth", block: "start" });
  respond("Your Spotify playlist is ready below. Choose a track to play.", false);
}

function showNotes() {
  let notes = [];
  try {
    notes = JSON.parse(localStorage.getItem("jarvisNotes") || "[]");
    if (!Array.isArray(notes)) notes = [];
  } catch (error) {
    notes = [];
  }

  const choice = prompt(
    "Notes:\n" + (notes.length ? notes.map((n, i) => (i + 1) + ". " + n).join("\n") : "No saved notes.") +
    "\n\nType a new note to save, or type DELETE to clear all notes."
  );
  if (choice === null || !choice.trim()) return;

  if (choice.trim().toUpperCase() === "DELETE") {
    localStorage.removeItem("jarvisNotes");
    respond("All saved notes have been deleted.");
    return;
  }

  notes.push(choice.trim());
  try {
    localStorage.setItem("jarvisNotes", JSON.stringify(notes));
    respond("Your note has been saved on this device.");
  } catch (error) {
    respond("I could not save the note in this browser.");
  }
}

// Safe basic calculator: only arithmetic characters are accepted.
function calculate() {
  const expression = prompt("Enter a calculation, e.g. 12*(4+2)");
  if (expression === null) return;

  const value = expression.replace(/\s/g, "");
  if (!value || !/^[0-9.+\-*/()%]+$/.test(value)) {
    respond("Use numbers and basic arithmetic operators only.");
    return;
  }

  try {
    // Validate tokens before evaluation.
    const tokens = value.match(/\d*\.?\d+|[()+\-*/%]/g) || [];
    if (tokens.join("") !== value) throw new Error("Invalid expression");
    const result = Function('"use strict"; return (' + value + ')')();
    if (typeof result !== "number" || !Number.isFinite(result)) {
      throw new Error("Invalid result");
    }
    respond("The answer is " + result + ".");
  } catch (error) {
    respond("Invalid calculation. Please check the expression.");
  }
}

function runCommand(raw) {
  const command = raw.trim().toLowerCase();
  if (!command) return;

  if (command === "help" || command.includes("commands")) {
    respond("Try: weather, music, time, date, notes, calculator, joke, or motivate me.");
  } else if (command.includes("weather") || command.includes("temperature") ||
             command.includes("rain")) {
    loadWeather();
  } else if (command.includes("music") || command.includes("spotify") ||
             command.includes("play song") || command.includes("playlist")) {
    showMusic();
  } else if (command.includes("time")) {
    respond("The current time is " + new Date().toLocaleTimeString() + ".");
  } else if (command.includes("date")) {
    respond("Today is " + new Date().toLocaleDateString() + ".");
  } else if (command.includes("note")) {
    showNotes();
  } else if (command.includes("calculator") || command === "calculate") {
    calculate();
  } else if (command.includes("joke")) {
    respond("Why did the computer go to the doctor? It had a virus!");
  } else if (command.includes("motivat")) {
    respond("Stay focused, Riyansh. Small consistent steps create big results.");
  } else if (command === "hello" || command.includes("hello jarvis") ||
             command === "hi" || command.includes("hi jarvis")) {
    respond("Hello Riyansh. JARVIS is online. How can I help?");
  } else {
    respond("I do not know that command yet. Type help to see available commands.");
  }
}

$("commandForm").addEventListener("submit", event => {
  event.preventDefault();
  const command = input.value;
  input.value = "";
  runCommand(command);
});

document.querySelectorAll("[data-command]").forEach(button => {
  button.addEventListener("click", () => runCommand(button.dataset.command));
});

$("refreshWeather").addEventListener("click", loadWeather);

const SpeechRecognitionAPI =
  window.SpeechRecognition || window.webkitSpeechRecognition;

$("micButton").addEventListener("click", () => {
  if (!SpeechRecognitionAPI) {
    respond("Voice input is not supported here. Please type your command.");
    return;
  }

  if (recognition) {
    recognition.stop();
    return;
  }

  recognition = new SpeechRecognitionAPI();
  recognition.lang = "en-IN";
  recognition.interimResults = false;
  recognition.maxAlternatives = 1;

  recognition.onstart = () => {
    $("micButton").textContent = "⏹";
    respond("Listening. Please speak now.", false);
  };

  recognition.onresult = event => {
    const spokenCommand = event.results[0][0].transcript;
    input.value = spokenCommand;
    runCommand(spokenCommand);
  };

  recognition.onerror = () => {
    respond("Microphone unavailable. Check browser permission and try again.", false);
  };

  recognition.onend = () => {
    $("micButton").textContent = "🎙";
    recognition = null;
  };

  try {
    recognition.start();
  } catch (error) {
    recognition = null;
    $("micButton").textContent = "🎙";
    respond("Please try voice input again.", false);
  }
});
</script>
</body>
</html>
