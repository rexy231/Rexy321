
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#050b18">
<title>JARVIS V8 — Personal Assistant</title>
<style>
:root{--bg:#050b18;--panel:#0b1528;--line:#18334b;--cyan:#35e6ff;--blue:#4e83ff;--text:#e8f8ff;--muted:#8aa9bb;--green:#55f2b0;--amber:#ffc66d}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 50% 5%,#102c48 0,#071324 42%,#030711 100%);color:var(--text);font-family:Arial,Helvetica,sans-serif}
button,input,textarea{font:inherit}
button{cursor:pointer}
.shell{width:min(100%,980px);margin:auto;padding:18px}
header{display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:1px solid var(--line);padding:8px 0 16px}
.brand{display:flex;align-items:center;gap:10px}
.brand-mark{width:44px;height:44px;border:1px solid var(--cyan);border-radius:50%;display:grid;place-items:center;color:var(--cyan);font-weight:800;box-shadow:0 0 20px #35e6ff22}
h1{font-size:1.05rem;letter-spacing:.16em;margin:0}
.subtitle{font-size:.75rem;color:var(--muted);margin-top:5px}
.status{font-size:.75rem;color:var(--green);border:1px solid #235b50;border-radius:99px;padding:7px 10px;white-space:nowrap}
main{display:grid;grid-template-columns:1fr 1fr;gap:16px;padding-top:18px}
.panel{background:linear-gradient(160deg,#0c1b2d,#081120);border:1px solid var(--line);border-radius:18px;padding:16px;min-width:0}
.hero{grid-column:1/-1;text-align:center;overflow:hidden}
.eyebrow{color:var(--cyan);letter-spacing:.18em;font-size:.72rem}
.reactor-wrap{height:210px;display:grid;place-items:center;position:relative}
.reactor{width:154px;height:154px;border:2px solid #35e6ff88;border-radius:50%;display:grid;place-items:center;position:relative;box-shadow:0 0 20px #35e6ff22,inset 0 0 22px #35e6ff18;animation:pulse 3s ease-in-out infinite}
.reactor:before,.reactor:after{content:"";position:absolute;border:1px solid #35e6ff66;border-radius:50%}
.reactor:before{inset:14px}
.reactor:after{inset:29px;border-style:dashed;animation:spin 18s linear infinite}
.core{width:42px;height:42px;background:radial-gradient(circle,#eaffff,#35e6ff 36%,#1670b9 70%,transparent 72%);border-radius:50%;box-shadow:0 0 26px var(--cyan)}
.orbit{position:absolute;width:190px;height:76px;border:1px solid #4e83ff88;border-radius:50%;transform:rotate(-30deg)}
.orbit.two{transform:rotate(48deg);width:190px;height:88px;border-color:#35e6ff66}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes pulse{50%{box-shadow:0 0 32px #35e6ff55,inset 0 0 28px #35e6ff22}}
h2{font-size:.95rem;margin:0 0 12px;letter-spacing:.06em}
p{line-height:1.5}
.muted{color:var(--muted);font-size:.86rem}
.big-time{font-size:1.75rem;font-variant-numeric:tabular-nums;color:var(--cyan);margin:8px 0}
.controls{display:flex;gap:9px;flex-wrap:wrap;justify-content:center}
.btn{border:1px solid #24516a;background:#10283d;color:var(--text);border-radius:11px;padding:11px 14px;min-height:44px}
.btn.primary{background:linear-gradient(110deg,#126b86,#164a82);border-color:var(--cyan);color:white}
.btn:hover{filter:brightness(1.15)}
.btn:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
#response{min-height:92px;white-space:pre-wrap;color:#d9f7ff;background:#06101d;border:1px solid #142c40;border-radius:12px;padding:12px;margin-top:12px;line-height:1.5}
#heard{color:var(--amber);font-size:.84rem;min-height:20px;margin-top:8px}
.quick{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.quick .btn{text-align:left}
.field{width:100%;background:#050d19;border:1px solid #234158;color:var(--text);border-radius:10px;padding:11px;margin:4px 0 10px}
textarea.field{min-height:90px;resize:vertical}
.note-list{display:grid;gap:8px;margin-top:10px}
.note{padding:10px;border:1px solid var(--line);border-radius:10px;display:flex;justify-content:space-between;gap:8px;align-items:start;overflow-wrap:anywhere}
.note span{flex:1;white-space:pre-wrap}
.delete{border:1px solid #653c4a;color:#ffb8c5;background:#28121c;border-radius:8px;padding:5px 8px}
.spotify-frame{display:block;width:100%;height:352px;border:0;border-radius:12px}
footer{text-align:center;color:var(--muted);font-size:.72rem;padding:20px 8px}
@media(max-width:650px){.shell{padding:12px}main{grid-template-columns:1fr}.hero{grid-column:auto}.reactor-wrap{height:190px}.panel{padding:14px}.status{font-size:.68rem}}
</style>
</head>
<body>
<div class="shell">
<header>
  <div class="brand">
    <div class="brand-mark">J</div>
    <div><h1>J.A.R.V.I.S. <span style="color:var(--cyan)">V8</span></h1><div class="subtitle">PERSONAL ASSISTANT SYSTEM</div></div>
  </div>
  <div class="status" id="status" role="status">● SYSTEM ONLINE</div>
</header>

<main>
<section class="panel hero">
  <div class="eyebrow">JUST A RATHER VERY INTELLIGENT SYSTEM</div>
  <div class="reactor-wrap" aria-label="Animated blue futuristic reactor">
    <div class="orbit"></div><div class="orbit two"></div>
    <div class="reactor"><div class="core"></div></div>
  </div>
  <div class="controls">
    <button class="btn primary" id="listenBtn">🎙️ TALK TO JARVIS</button>
    <button class="btn" id="stopBtn">■ STOP VOICE</button>
  </div>
  <div id="heard" aria-live="polite">Say “Hello Jarvis” or try “What time is it?”</div>
  <div id="response" aria-live="polite">Good day. JARVIS V8 is ready. Choose a command or use the microphone.</div>
  <p class="muted">Voice recognition depends on browser support and microphone permission.</p>
</section>

<section class="panel">
  <h2>⌚ SYSTEM STATUS</h2>
  <div class="big-time" id="clock">--:--:--</div>
  <div id="date" class="muted">Loading date…</div>
  <div style="height:12px"></div>
  <div class="quick">
    <button class="btn" data-command="time">🕒 Tell me the time</button>
    <button class="btn" data-command="date">📅 Tell me the date</button>
    <button class="btn" data-command="help">❔ Help</button>
    <button class="btn" data-command="joke">😄 Tell me a joke</button>
    <button class="btn" data-command="motivate">⚡ Motivate me</button>
    <button class="btn" data-command="hello">👋 Say hello</button>
    <button class="btn primary" data-command="music">🎵 Open Spotify</button>
  </div>
</section>

<section class="panel">
  <h2>🧮 QUICK CALCULATOR</h2>
  <label class="muted" for="calcInput">Example: 25 * 4 + 10</label>
  <input class="field" id="calcInput" inputmode="decimal" placeholder="25 * 4 + 10" maxlength="80">
  <button class="btn primary" id="calcBtn">Calculate</button>
  <div id="calcResult" class="muted" style="margin-top:10px" aria-live="polite">Your result will appear here.</div>
</section>

<section class="panel" style="grid-column:1/-1">
  <h2>🎵 JARVIS MUSIC PLAYER — SPOTIFY</h2>
  <p class="muted">Your playlist, directly inside JARVIS. Tap Play in the Spotify player below.</p>
  <iframe
    class="spotify-frame"
    src="https://open.spotify.com/embed/playlist/1Zxvk6LxitGP1gUmeu40KK?utm_source=generator"
    title="Your Spotify playlist"
    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
    loading="lazy">
  </iframe>
  <p class="muted">Spotify playback and available tracks depend on your account, region, and Spotify's playback rules.</p>
</section>

<section class="panel" style="grid-column:1/-1">
  <h2>📝 MEMORY NOTES</h2>
  <label class="muted" for="noteInput">Save a reminder or thought on this device</label>
  <textarea class="field" id="noteInput" placeholder="Example: Revise motion in a straight line"></textarea>
  <button class="btn primary" id="saveNote">Save note</button>
  <div id="notes" class="note-list"></div>
  <p class="muted">Notes are stored in this browser on this device. Clearing browser data may erase them.</p>
</section>
</main>

<footer>JARVIS V8 • Personal project • Spotify embed and browser features</footer>
</div>

<script>
(function(){
  const $=id=>document.getElementById(id);
  const response=$('response'), status=$('status'), heard=$('heard');
  let recognition=null;

  function updateClock(){
    const now=new Date();
    $('clock').textContent=now.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit',second:'2-digit'});
    $('date').textContent=now.toLocaleDateString([], {weekday:'long',year:'numeric',month:'long',day:'numeric'});
  }
  updateClock();
  setInterval(updateClock,1000);

  function say(text){
    response.textContent=text;
    if('speechSynthesis' in window){
      window.speechSynthesis.cancel();
      const utterance=new SpeechSynthesisUtterance(text);
      utterance.lang='en-IN';
      utterance.rate=0.94;
      utterance.pitch=0.82;
      window.speechSynthesis.speak(utterance);
    }
  }

  function runCommand(raw){
    const text=String(raw||'').trim().toLowerCase();
    heard.textContent=text ? 'You said: '+raw : '';
    if(!text){say('I did not hear a command. Please try again.');return;}

    if(/\b(music|spotify|playlist|play songs)\b/.test(text)){
      document.querySelector('.spotify-frame').scrollIntoView({behavior:'smooth',block:'center'});
      say('Opening your Spotify playlist. Tap the play button in the Spotify player.');
      return;
    }
    if(/\b(time|clock)\b/.test(text)){say('The time is '+new Date().toLocaleTimeString([], {hour:'numeric',minute:'2-digit'}));return;}
    if(/\b(date|day|today)\b/.test(text)){say('Today is '+new Date().toLocaleDateString([], {weekday:'long',year:'numeric',month:'long',day:'numeric'}));return;}
    if(/\b(hello|hi|hey|jarvis)\b/.test(text)){say('Hello. JARVIS V8 is online and ready to assist you.');return;}
    if(/\b(help|commands|what can you do)\b/.test(text)){say('I can tell the time and date, open your Spotify playlist, tell a joke, give motivation, calculate basic sums, and save notes.');return;}
    if(/\b(joke|funny)\b/.test(text)){say('Why did the computer go to the doctor? It had a virus.');return;}
    if(/\b(motivate|motivation|inspire)\b/.test(text)){say('Progress is built one focused step at a time. Start with the next useful task.');return;}
    if(text.startsWith('calculate ')){const expr=raw.trim().slice(10);$('calcInput').value=expr;calculate();return;}
    if(text.startsWith('remember ')){const note=raw.trim().slice(9).trim();if(note){saveNote(note);say('I saved that note on this device.');return;}}
    say('I can help with time, date, Spotify, calculations, notes, jokes, and motivation. Say help to hear the command list.');
  }

  function startListening(){
    const SpeechRecognition=window.SpeechRecognition||window.webkitSpeechRecognition;
    if(!SpeechRecognition){status.textContent='● VOICE NOT SUPPORTED';say('Voice recognition is not available in this browser. Try Chrome or use the buttons.');return;}
    try{
      recognition=new SpeechRecognition();
      recognition.lang='en-IN';
      recognition.interimResults=false;
      recognition.maxAlternatives=1;
      recognition.onstart=()=>{status.textContent='● LISTENING';heard.textContent='Listening…';};
      recognition.onresult=e=>runCommand(e.results[0][0].transcript);
      recognition.onerror=e=>{status.textContent='● VOICE ISSUE';heard.textContent='Voice error: '+e.error;say('I could not access voice input. Check microphone permission and try again.');};
      recognition.onend=()=>{status.textContent='● SYSTEM ONLINE';};
      recognition.start();
    }catch(e){status.textContent='● SYSTEM ONLINE';say('Please try the microphone button again.');}
  }

  $('listenBtn').addEventListener('click',startListening);
  $('stopBtn').addEventListener('click',()=>{
    if(recognition){try{recognition.stop();}catch(e){}}
    if('speechSynthesis' in window)window.speechSynthesis.cancel();
    status.textContent='● SYSTEM ONLINE';
  });
  document.querySelectorAll('[data-command]').forEach(btn=>btn.addEventListener('click',()=>runCommand(btn.dataset.command)));

  function calculate(){
    const expr=$('calcInput').value.trim();
    if(!expr){$('calcResult').textContent='Enter a calculation first.';return;}
    if(!/^[\d\s.+\-*/()%]+$/.test(expr)){
      $('calcResult').textContent='Use only numbers, operators, parentheses and %.';
      return;
    }
    try{
      const result=Function('"use strict"; return ('+expr+')')();
      if(typeof result!=='number'||!Number.isFinite(result))throw new Error('invalid');
      $('calcResult').textContent='Result: '+result;
    }catch(e){$('calcResult').textContent='That calculation could not be evaluated. Check the expression.';}
  }
  $('calcBtn').addEventListener('click',calculate);
  $('calcInput').addEventListener('keydown',e=>{if(e.key==='Enter')calculate();});

  function getNotes(){try{return JSON.parse(localStorage.getItem('jarvis_v8_notes')||'[]');}catch(e){return [];}}
  function saveNote(text){
    const notes=getNotes();
    notes.unshift({id:Date.now(),text:text});
    try{
      localStorage.setItem('jarvis_v8_notes',JSON.stringify(notes.slice(0,100)));
      renderNotes();
    }catch(e){say('Storage is unavailable. Your note could not be saved.');}
  }
  $('saveNote').addEventListener('click',()=>{
    const text=$('noteInput').value.trim();
    if(!text){$('noteInput').focus();return;}
    saveNote(text);
    $('noteInput').value='';
  });
  function renderNotes(){
    const root=$('notes');
    root.replaceChildren();
    getNotes().forEach(note=>{
      const row=document.createElement('div');
      row.className='note';
      const span=document.createElement('span');
      span.textContent=note.text;
      const del=document.createElement('button');
      del.className='delete';
      del.type='button';
      del.textContent='Delete';
      del.setAttribute('aria-label','Delete note');
      del.addEventListener('click',()=>{
        try{
          localStorage.setItem('jarvis_v8_notes',JSON.stringify(getNotes().filter(n=>n.id!==note.id)));
          renderNotes();
        }catch(e){}
      });
      row.append(span,del);
      root.append(row);
    });
    if(!root.children.length){
      const p=document.createElement('p');
      p.className='muted';
      p.textContent='No saved notes yet.';
      root.append(p);
    }
  }
  renderNotes();
})();
</script>
</body>
</html>
